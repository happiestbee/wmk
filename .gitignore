/.claude

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
/.venv/

# Model weights: 41 GB, restaged by scripts/00_setup.py and hash-verified against
# data/MANIFEST.json, which IS tracked.
/data/weights/

# Probability cache: regenerated by scripts/02_cache_probs.py. Large and derived.
/data/probs/
*.npz
*.tmp

# Corpora: rebuilt byte-identically by scripts/00c_build_corpora.py --seed 0 and
# verified against the sha256 in data/corpora/MANIFEST_corpora.json, which IS tracked.
/data/corpora/*.jsonl

# Figures regenerate from results/ via scripts/08_make_figures.py (C5).
/results/figures/

# Run transcripts, not results.
/logs/*.log
